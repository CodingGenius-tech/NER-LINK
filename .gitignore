# ==========================================
# NER-LINK - Git Ignore
# ==========================================

# Environment variables
.env
.env.*
!.env.example

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# React / Vite
client/dist/
client/.vite/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python virtual environments
.venv/
venv/
env/

# ML artifacts
*.pkl
*.joblib
*.pickle

# Large datasets
data/raw/
data/processed/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
logs/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary files
*.tmp
*.temp

# Python test/cache
.pytest_cache/
.mypy_cache/

# Coverage
.coverage
htmlcov/

# Build/cache
.cache/